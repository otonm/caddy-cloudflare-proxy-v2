# Required — Cloudflare API token with Zone:DNS:Edit permission
CF_API_TOKEN=your_cloudflare_api_token_here

# Required — Tailscale API key
TS_API_KEY=tskey-api-xxxxxxxxxxxxxxxxxxxxx

# Required — Tailscale tailnet (e.g. "myuser.github" or "example.com")
TS_TAILNET=your-tailnet-name

# Required — Email for ACME certificate registration
ACME_EMAIL=admin@example.com

# Optional — Override detected public IP. If not set, auto-detected via api4.ipify.org.
# PUBLIC_IP=1.2.3.4

# Optional — Enable verbose debug logging (secrets are never logged regardless)
DEBUG=false

# Optional — How often (seconds) the main page auto-refreshes from Cloudflare and the store.
# Minimum 30. Default: 60.
# REFRESH_INTERVAL=60

# Optional — Secret used to encrypt NiceGUI browser session storage.
# If not set, a secret is auto-generated on first boot and persisted in
# /data/app_secret.txt (the Docker volume).  The generated value is logged once
# so you can copy it here to keep sessions stable across container recreations
# or when moving the deployment to a new host.
# APP_SECRET=your-64-char-hex-secret-here