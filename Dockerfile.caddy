FROM caddy:builder AS builder

# xcaddy compiles the Cloudflare DNS plugin into the Caddy binary at build time.
# The standard caddy image has no runtime plugin loading, so this is required
# for DNS-01 ACME challenges via Cloudflare.
RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare

FROM caddy:latest

COPY --from=builder /usr/bin/caddy /usr/bin/caddy

# Bind the admin API to all interfaces so the app container can reach it
# via the Docker network hostname (caddy:2019). The default "localhost:2019"
# only listens on loopback and is unreachable from other containers.
RUN printf '{\n\tadmin 0.0.0.0:2019\n}\n' > /etc/caddy/Caddyfile
